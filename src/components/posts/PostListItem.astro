---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import { type CollectionItem } from "@/content";
import { SITE } from "@/config";
import { getT } from "@/i18n/ui";
import { formatPostListDate } from "./post-parts";

interface Props {
  item: CollectionItem;
}

const { item } = Astro.props;
const { lang, t } = getT(Astro.currentLocale);
const { frontmatter } = item;

const title = frontmatter.title ?? item.slug;
const description =
  typeof frontmatter.desc === "string" ? frontmatter.desc.trim() : "";
const publishedAt = formatPostListDate(frontmatter["published-at"]);
const updatedAt = formatPostListDate(frontmatter["updated-at"]);
const hasDistinctUpdate = Boolean(updatedAt && updatedAt !== publishedAt);
const tags: string[] = frontmatter.tags ?? [];
const searchUrl = getRelativeLocaleUrl(lang, "search");
const pageWidth = "max-w-" + SITE.page_width;
---

<article
  class:list={[
    pageWidth,
    "post-list-item group relative mx-auto border-b border-gray-200/80 dark:border-gray-700/80",
  ]}
>
  <a
    href={item.slug}
    class="post-list-item-link absolute inset-0 z-0 rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
    aria-label={title}
  ></a>

  <div class="relative z-10 pointer-events-none px-4 py-6 sm:px-8 sm:py-7">
    <div class="pr-10">
      <h2 class="m-0 text-xl font-semibold leading-tight text-gray-900 dark:text-gray-100 sm:text-[1.35rem]">
        {title}
      </h2>
      {
        description && (
          <p class="mt-3 mb-0 text-base leading-7 text-gray-600 dark:text-gray-300">
            {description}
          </p>
        )
      }
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
      {
        publishedAt && (
          <time datetime={frontmatter["published-at"]}>
            {publishedAt}
          </time>
        )
      }
      {
        hasDistinctUpdate && (
          <time datetime={frontmatter["updated-at"]}>
            {t("article.updated_at")} {updatedAt}
          </time>
        )
      }
      {
        tags.map((tag) => (
          <a
            href={`${searchUrl}?${new URLSearchParams({ tag })}`}
            class="pointer-events-auto relative z-20 shrink-0 whitespace-nowrap rounded-sm border border-gray-300 px-2 py-0.5 text-xs text-gray-600 transition-colors hover:border-blue-400 hover:text-blue-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:border-gray-600 dark:text-gray-300 dark:hover:border-blue-500 dark:hover:text-blue-300"
          >
            {tag}
          </a>
        ))
      }
    </div>
  </div>

  <Icon
    name="tabler:arrow-up-right"
    class="pointer-events-none absolute right-4 top-6 z-10 size-5 text-gray-400 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-blue-500 sm:right-8 sm:top-7"
    aria-hidden="true"
  />
</article>

<style>
  .post-list-item {
    transition: background-color 160ms ease;

    &::before {
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      width: 0.125rem;
      background: var(--color-blue-500);
      content: "";
      opacity: 0;
      transition: opacity 160ms ease;
    }

    &:hover,
    &:focus-within {
      background: color-mix(in srgb, var(--article-bg) 88%, currentColor 12%);

      &::before {
        opacity: 1;
      }
    }
  }
</style>
