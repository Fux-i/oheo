---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import { type CollectionItem } from "@/content";
import { SITE } from "@/config";
import { getT } from "@/i18n/ui";
import { formatPostDate } from "./post-parts";
import Outline from "../utils/Outline.astro";

interface Props {
  item: CollectionItem;
  exclusive: boolean;
}

const { item, exclusive } = Astro.props;
const { Content, frontmatter } = item;
const { lang, t } = getT(Astro.currentLocale);

const page_width = "max-w-" + SITE.page_width;

const publishedAt = frontmatter["published-at"];
const updatedAt = frontmatter["updated-at"];
const publishedAtLabel = formatPostDate(publishedAt);
const updatedAtLabel = formatPostDate(updatedAt);
const tags: string[] = frontmatter.tags ?? [];
const hasMeta = publishedAt || updatedAt || tags.length > 0;
const title = frontmatter.title ?? item.slug;
const searchUrl = getRelativeLocaleUrl(lang, "search");
const searchAttributes = exclusive
  ? {
      "data-search-document": "",
      "data-search-id": `post:${lang}:${item.slug}`,
      "data-search-kind": "post",
      "data-search-lang": lang,
      "data-search-url": Astro.url.pathname,
      "data-search-root-anchor": item.slug,
      "data-search-title": title,
      "data-search-display-title": title,
      "data-search-description": frontmatter.desc ?? "",
      "data-search-date": publishedAt ?? "",
      "data-search-tags": JSON.stringify(tags),
    }
  : {};
---

<div
  {...searchAttributes}
  class:list={[
    page_width,
    "article-wrapper relative mx-auto shadow",
    !exclusive && "collapsible my-4",
  ]}
>
  <article
    data-search-body={exclusive ? "" : undefined}
    class:list={[
      "article bg-(--article-bg) py-4",
      exclusive ? "px-8" : "px-4 sm:px-8",
      !exclusive &&
        "h-64 overflow-hidden transition-[height] duration-300 sm:h-48",
    ]}
  >
    {
      exclusive ? (
        <h1 id={item.slug} data-search-exclude data-search-highlight-title>
          {title}
        </h1>
      ) : (
        <a
          href={item.slug}
          class:list={"title-a text-xl transition-[font-size] duration-300"}
        >
          <b>{title}</b>
        </a>
      )
    }
    {
      hasMeta && (
        <post-meta
          data-search-exclude
          class="my-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-500 dark:text-gray-400"
        >
          {(publishedAt || updatedAt) && (
            <span class="min-w-0">
              {publishedAt && (
                <span>
                  {t("article.published_at")}{" "}
                  <time datetime={publishedAt}>{publishedAtLabel}</time>
                </span>
              )}
              {updatedAt && (
                <span>
                  {t("article.updated_at")}{" "}
                  <time datetime={updatedAt}>{updatedAtLabel}</time>
                </span>
              )}
            </span>
          )}
          {tags.length > 0 && (
            <tag-list class="no-article flex flex-wrap items-center gap-2">
              {tags.map((tag) => (
                <a
                  href={`${searchUrl}?${new URLSearchParams({ tag })}`}
                  class="shrink-0 whitespace-nowrap border border-gray-200 px-2 py-0.5 text-xs text-gray-600 transition-colors hover:border-blue-400 hover:text-blue-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:border-gray-600 dark:text-gray-300 dark:hover:border-blue-500 dark:hover:text-blue-300"
                >
                  {tag}
                </a>
              ))}
            </tag-list>
          )}
        </post-meta>
      )
    }
    <Content />
  </article>
  <sticky-rail
    class:list={[
      "sticky-rail pointer-events-none absolute inset-y-0 -right-4 z-20 w-0 transition-opacity duration-300",
      exclusive ? "opacity-100" : "invisible opacity-0",
    ]}
  >
    <div class="sticky top-20 flex gap-2">
      <Outline toc={item.headings} />
      {
        !exclusive && (
          <button
            type="button"
            title={t("article.collapse")}
            aria-label={t("article.collapse")}
            class="absolute left-13 collapse-btn grid size-10 shrink-0 cursor-pointer place-items-center rounded-full bg-(--article-bg) shadow hover:brightness-90"
          >
            <Icon name="tabler:chevrons-up" class="size-5" />
          </button>
        )
      }
    </div>
  </sticky-rail>
  {
    !exclusive && (
      <div class="fade-mask absolute inset-x-0 bottom-0 h-35 cursor-pointer transition-opacity duration-300">
        <p class="text-blue-500 text-center w-full absolute bottom-2">
          {t("article.expand")}
        </p>
      </div>
    )
  }
</div>

<style>
  .fade-mask {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--article-bg) 0%, transparent),
      var(--article-bg)
    );
  }
  .collapsible.expanded > article {
    height: auto;
    height: calc-size(auto, size);
  }
  .expanded .fade-mask {
    opacity: 0;
    pointer-events: none;
  }
  .expanded .sticky-rail {
    opacity: 1;
    visibility: visible;
  }
  :global(html),
  :global(body) {
    overflow-x: clip;
  }
  .outline-inset .sticky-rail {
    inset: 1rem 1rem 0 auto;
    width: min(18rem, calc(100% - 2rem));
  }
  .outline-inset .sticky-rail > .sticky {
    top: 5rem;
    width: 100%;
    transform: none;
  }
  .outline-inset .outline-box {
    width: 100%;
  }
  .outline-inset .outline-toggle {
    margin-inline-start: auto;
  }
  .outline-inset .collapse-btn {
    right: 3.25rem;
    left: auto;
  }
  .sticky-rail :global(.outline-toggle),
  .sticky-rail :global(.outline-nav),
  .sticky-rail .collapse-btn {
    pointer-events: auto;
  }
  .expanded {
    a.title-a {
      font-size: 2rem;
    }
  }
</style>

<script>
  import "./search-highlight";

  document.querySelectorAll<HTMLButtonElement>(".fade-mask").forEach((mask) => {
    mask.addEventListener("click", () => {
      mask.closest(".article-wrapper")?.classList.add("expanded");
      window.dispatchEvent(new CustomEvent("article-layout-change"));
    });
  });
  document
    .querySelectorAll<HTMLButtonElement>(".collapse-btn")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        btn.closest(".article-wrapper")?.classList.remove("expanded");
        window.dispatchEvent(new CustomEvent("article-layout-change"));
      });
    });
</script>
