---
import { getRelativeLocaleUrl } from "astro:i18n";
import { type CollectionItem } from "@/content";
import { SITE } from "@/config";
import { getT } from "@/i18n/ui";
import { formatPostDate } from "./post-parts";
import Outline from "@/components/utils/Outline.astro";

interface Props {
  item: CollectionItem;
}

const { item } = Astro.props;
const { Content, frontmatter } = item;
const { lang, t } = getT(Astro.currentLocale);

const pageWidth = "max-w-" + SITE.page_width;
const publishedAt = frontmatter["published-at"];
const updatedAt = frontmatter["updated-at"];
const publishedAtLabel = formatPostDate(publishedAt);
const updatedAtLabel = formatPostDate(updatedAt);
const tags: string[] = frontmatter.tags ?? [];
const hasMeta = publishedAt || updatedAt || tags.length > 0;
const title = frontmatter.title ?? item.slug;
const contentId = `article-${item.slug}`;
const searchUrl = getRelativeLocaleUrl(lang, "search");
const searchAttributes = {
  "data-search-document": "",
  "data-search-id": `post:${lang}:${item.slug}`,
  "data-search-kind": "post",
  "data-search-lang": lang,
  "data-search-url": Astro.url.pathname,
  "data-search-root-anchor": item.slug,
  "data-search-title": title,
  "data-search-display-title": title,
  "data-search-description": frontmatter.desc ?? "",
  "data-search-date": publishedAt ?? "",
  "data-search-tags": JSON.stringify(tags),
};
---

<div {...searchAttributes} class:list={[pageWidth, "article-wrapper relative mx-auto shadow"]}>
  <article id={contentId} data-search-body class="article bg-(--article-bg) px-4 py-4 sm:px-8">
    <h1 id={item.slug} data-search-exclude data-search-highlight-title>
      {title}
    </h1>
    {
      hasMeta && (
        <post-meta
          data-search-exclude
          class="my-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-500 dark:text-gray-400"
        >
          {(publishedAt || updatedAt) && (
            <span class="min-w-0">
              {publishedAt && (
                <span>
                  {t("article.published_at")} {" "}
                  <time datetime={publishedAt}>{publishedAtLabel}</time>
                </span>
              )}
              {updatedAt && (
                <span>
                  {t("article.updated_at")} {" "}
                  <time datetime={updatedAt}>{updatedAtLabel}</time>
                </span>
              )}
            </span>
          )}
          {tags.length > 0 && (
            <tag-list class="no-article flex flex-wrap items-center gap-2">
              {tags.map((tag) => (
                <a
                  href={`${searchUrl}?${new URLSearchParams({ tag })}`}
                  class="shrink-0 whitespace-nowrap border border-gray-200 px-2 py-0.5 text-xs text-gray-600 transition-colors hover:border-blue-400 hover:text-blue-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:border-gray-600 dark:text-gray-300 dark:hover:border-blue-500 dark:hover:text-blue-300"
                >
                  {tag}
                </a>
              ))}
            </tag-list>
          )}
        </post-meta>
      )
    }
    <Content />
  </article>
  <Outline toc={item.headings} contentId={contentId} />
</div>

<style>
  :global(html),
  :global(body) {
    overflow-x: clip;
  }
</style>

<script>
  import "./search-highlight";
</script>
