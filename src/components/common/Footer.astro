---
import { SITE } from "@/config";
import IconAstro from "@/assets/astro.svg";

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
---

<footer class:list={["w-full px-4", isHome ? "mt-0 shrink-0" : "mt-16"]}>
  <div
    class:list={[
      "mx-auto flex flex-col items-center gap-2 text-gray-500 dark:text-gray-400",
      isHome ? "py-3 text-xs sm:py-4 sm:text-sm" : "py-8 text-sm",
    ]}
  >
    <p>Copyright © {new Date().getFullYear()} {SITE.author}</p>
    <p>
      Powered by
      <a href="https://astro.build/" target="_blank" class="hover:underline"
        ><IconAstro
          viewBox="0 0 115 48"
          class="inline h-[1.75em] w-auto dark:invert"
        /></a
      >
      | Themed by
      <a
        href="https://github.com/fux-i/oheo"
        target="_blank"
        class="hover:underline">oheo</a
      >
    </p>
  </div>
</footer>
