---
import { getRelativeLocaleUrl } from "astro:i18n";
import { type CollectionItem } from "@/content";
import { getT } from "@/i18n/ui";
import { getMomentAnchor, getMomentDate } from "./moment-parts";

interface Props {
  item: CollectionItem;
}

const { item } = Astro.props;
const { Content, frontmatter } = item;
const { lang, t } = getT(Astro.currentLocale);
const date = getMomentDate(item);
const anchor = getMomentAnchor(item);
const title = frontmatter.title ?? `${t("search.moment")} · ${date}`;
const tags: string[] = frontmatter.tags ?? [];
const momentsUrl = getRelativeLocaleUrl(lang, "moments").replace(/\/$/, "");
const url = `${momentsUrl}#${encodeURIComponent(anchor)}`;
const dateParts = date.match(/^(\d{4})-(\d{2})-(\d{2})$/);
const year = dateParts?.[1] ?? "";
const month = dateParts ? String(Number(dateParts[2])) : "";
const day = dateParts ? String(Number(dateParts[3])) : date;
---

<moment-card
  id={anchor}
  data-search-document
  data-search-id={`moment:${lang}:${item.slug}`}
  data-search-kind="moment"
  data-search-lang={lang}
  data-search-url={url}
  data-search-title={title}
  data-search-date={date}
  data-search-tags={JSON.stringify(tags)}
  class="relative grid min-w-0 scroll-mt-20 gap-4 sm:grid-cols-[6rem_minmax(0,1fr)]"
>
  <time-rail
    class="relative flex items-start gap-3 sm:block sm:pt-3 sm:text-right"
  >
    <time datetime={date} class="block">
      <span class="block leading-none text-gray-950 dark:text-gray-50">
        <span class="text-3xl font-semibold">{day}</span>
        {
          month && (
            <span class="ml-1 text-sm font-medium text-gray-500 dark:text-gray-400">
              / {month}
            </span>
          )
        }
      </span>
      <span
        class="mt-1 block text-xs uppercase text-gray-500 dark:text-gray-400"
      >
        {year}
      </span>
    </time>
  </time-rail>

  <moment-body class="relative ml-4 block min-w-0 pl-4 sm:ml-0 sm:pl-6">
    <article
      data-search-body
      class="min-w-0 rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-5"
    >
      <moment-content
        class="article moment-content block min-w-0 text-gray-800 dark:text-gray-100"
      >
        <Content />
      </moment-content>
    </article>
  </moment-body>
</moment-card>

<style>
  moment-content {
    font-size: 0.96rem;

    & :global(h2:not(.no-article *)) {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-block: 0;
      border-radius: 0.375rem;
      color: var(--color-blue-600);
      font-size: 0.75rem;
      font-weight: 500;
      line-height: 1;
    }

    & :global(h2:not(.no-article *):not(:first-child)) {
      margin-block-start: 1.25rem;
    }

    & :global(h2:not(.no-article *)::before) {
      content: "";
      width: 0.375rem;
      height: 0.375rem;
      border-radius: 9999px;
      background: var(--color-blue-500);
    }

    & :global(p:first-child) {
      margin-block-start: 0;
    }

    & :global(.image-viewer-row) {
      margin-block-start: 0;
    }

    & :global(p:last-child),
    & :global(img:last-child),
    & :global(.image-viewer-row:last-child) {
      margin-block-end: 0;
    }

    & :global(img) {
      border-radius: 0.5rem;
      border: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    }

    & :global(.expressive-code),
    & :global(pre:not(.no-article *)) {
      max-width: 100%;
      overflow-x: auto;
    }
  }
</style>
