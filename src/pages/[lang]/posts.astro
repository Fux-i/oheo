---
import Layout from "@/layouts/Layout.astro";
import Article from "@/components/posts/Article.astro";
import { comparePosts } from "@/components/posts/post-parts";
import { getT } from "@/i18n/ui";
import { getCollection } from "@/content";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}
const { lang, t } = getT(Astro.currentLocale);
const posts = getCollection("posts", lang).sort(comparePosts);
---

<Layout title={t("nav.posts") + t("site.title_suffix")} desc="">
  <container class="w-full relative">
    <main class:list={["main w-full px-4 overflow-x-clip"]}>
      {posts.map((p) => <Article item={p} exclusive={false} />)}
    </main>
  </container>
</Layout>
