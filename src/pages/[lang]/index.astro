---
import HomePage from "@/components/home/HomePage.astro";
import HomeLayout from "@/layouts/HomeLayout.astro";
import { getT } from "@/i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}
const { t } = getT(Astro.currentLocale);
---

<HomeLayout title={t("site.title")} desc="">
  <HomePage />
</HomeLayout>
