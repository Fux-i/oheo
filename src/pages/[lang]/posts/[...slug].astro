---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Article from "@/components/posts/Article.astro";
import { getCollection, type CollectionItem } from "@/content";
import { getT, type Lang } from "@/i18n/ui";

export function getStaticPaths() {
  const langs: Lang[] = ["en", "zh"];
  return langs.flatMap((lang) =>
    getCollection("posts", lang).map((p) => ({
      params: { lang, slug: p.slug },
      props: { item: p },
    })),
  );
}

const { item } = Astro.props as { item: CollectionItem };
const { frontmatter } = item;
const { lang } = getT(Astro.currentLocale);
---

<Layout
  title={frontmatter.title ?? item.slug}
  desc={frontmatter.desc ?? ""}
  backHref={getRelativeLocaleUrl(lang, "posts")}
>
  <Article item={item} exclusive={true} />
</Layout>
