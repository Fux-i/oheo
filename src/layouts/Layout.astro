---
import BaseHead from "@/components/common/BaseHead.astro";
import Header from "@/components/common/Header.astro";
import ImageViewer from "@/components/common/ImageViewer.astro";
import ThemeScript from "@/components/common/ThemeScript.astro";
import Footer from "@/components/common/Footer.astro";
import VideoAssets from "@/components/common/VideoAssets.astro";
import { getT } from "@/i18n/ui";

interface Props {
  title: string;
  desc: string;
  image?: ImageMetadata;
  backHref?: string;
  fillViewport?: boolean;
}

let { title, desc, image = undefined, backHref, fillViewport = false } = Astro.props;
const { t } = getT(Astro.currentLocale);
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
  <head>
    <BaseHead title={title} desc={desc} image={image} />
    <ThemeScript />
  </head>
  <body
    class:list={[
      "bg-gray-100 pt-16 text-gray-900 dark:bg-gray-900 dark:text-gray-100",
      { "flex min-h-svh flex-col": fillViewport },
    ]}
  >
    <Header backHref={backHref} />
    <VideoAssets>
      <slot />
    </VideoAssets>
    <ImageViewer
      labels={{
        close: t("viewer.close"),
        zoom: t("viewer.zoom"),
        previous: t("viewer.previous"),
        next: t("viewer.next"),
        error: t("viewer.error"),
      }}
    />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
