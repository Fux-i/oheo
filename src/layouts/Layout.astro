---
import BaseHead from "@/components/common/BaseHead.astro";
import Header from "@/components/common/Header.astro";
import ImageViewer from "@/components/common/ImageViewer.astro";
import ThemeScript from "@/components/common/ThemeScript.astro";
import Footer from "@/components/common/Footer.astro";
import { getT } from "@/i18n/ui";

interface Props {
  title: string;
  desc: string;
  image?: ImageMetadata;
}

let { title, desc, image = undefined } = Astro.props;
const { t } = getT(Astro.currentLocale);
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
  <head>
    <BaseHead title={title} desc={desc} image={image} />
    <ThemeScript />
  </head>
  <body class="bg-gray-100 text-gray-900 dark:bg-gray-900 dark:text-gray-100 pt-16">
    <Header />
    <slot />
    <ImageViewer
      labels={{
        close: t("viewer.close"),
        zoom: t("viewer.zoom"),
        previous: t("viewer.previous"),
        next: t("viewer.next"),
        error: t("viewer.error"),
      }}
    />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
